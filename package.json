{
  "name": "code-evolution-lens",
  "displayName": "code-evolution-lens",
  "description": "%extension.description%",
  "version": "0.3.4",
  "publisher": "luorAx",
  "repository": {
    "type": "git",
    "url": "https://github.com/moshuipan/code-evolution-lens.git"
  },
  "homepage": "https://github.com/moshuipan/code-evolution-lens#readme",
  "bugs": {
    "url": "https://github.com/moshuipan/code-evolution-lens/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "git",
    "code quality",
    "analytics",
    "ai",
    "rewrite"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%workspace.trust%"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeEvolutionLens",
          "title": "code-evolution-lens",
          "icon": "media/lens.svg"
        }
      ]
    },
    "views": {
      "codeEvolutionLens": [
        {
          "id": "codeEvolutionLens.tree",
          "name": "%views.repositories%"
        }
      ]
    },
    "commands": [
      {
        "command": "codeEvolutionLens.openTrends",
        "title": "%commands.openTrends%",
        "icon": "$(graph-line)"
      },
      {
        "command": "codeEvolutionLens.openRepositoryTerminal",
        "title": "%commands.openRepositoryTerminal%"
      },
      {
        "command": "codeEvolutionLens.openFile",
        "title": "%commands.openFile%"
      },
      {
        "command": "codeEvolutionLens.refresh",
        "title": "%commands.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "codeEvolutionLens.cancelIndex",
        "title": "%commands.cancelIndex%",
        "icon": "$(close)"
      },
      {
        "command": "codeEvolutionLens.showFileEvents",
        "title": "%commands.showFileEvents%"
      },
      {
        "command": "codeEvolutionLens.showLineDetail",
        "title": "%commands.showLineDetail%"
      },
      {
        "command": "codeEvolutionLens.openRewriteDiff",
        "title": "%commands.openRewriteDiff%"
      },
      {
        "command": "codeEvolutionLens.revealCurrent",
        "title": "%commands.revealCurrent%"
      },
      {
        "command": "codeEvolutionLens.toggleDecorations",
        "title": "%commands.toggleDecorations%"
      },
      {
        "command": "codeEvolutionLens.showMethodology",
        "title": "%commands.showMethodology%"
      },
      {
        "command": "codeEvolutionLens.clearCache",
        "title": "%commands.clearCache%"
      },
      {
        "command": "codeEvolutionLens.showDiagnostics",
        "title": "%commands.showDiagnostics%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeEvolutionLens.openTrends",
          "when": "view == codeEvolutionLens.tree",
          "group": "navigation@0"
        },
        {
          "command": "codeEvolutionLens.refresh",
          "when": "view == codeEvolutionLens.tree",
          "group": "navigation"
        },
        {
          "command": "codeEvolutionLens.cancelIndex",
          "when": "view == codeEvolutionLens.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codeEvolutionLens.openFile",
          "when": "viewItem == lensFile",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codeEvolutionLens.showLineDetail",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "navigation@90"
        },
        {
          "command": "codeEvolutionLens.showFileEvents",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "code-evolution-lens",
      "properties": {
        "codeEvolutionLens.ref": {
          "type": "string",
          "default": "HEAD",
          "examples": ["HEAD", "main", "origin/main"],
          "markdownDescription": "%settings.ref%"
