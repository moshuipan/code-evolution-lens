          "defaultSnippets": [
            {
              "label": "%settings.aiProviders.snippet%",
              "body": [
                {
                  "provider": "内部编码助手",
                  "emails": ["internal-codebot"],
                  "nameTokens": ["internal assistant"],
                  "bracketTags": ["internal-ai"],
                  "messageMarkers": ["Generated with Internal Assistant"],
                  "subjectPrefixes": ["internal-ai:"]
                }
              ]
            }
          ],
          "examples": [[{"provider": "内部编码助手", "emails": ["internal-codebot"], "nameTokens": ["internal assistant"]}]],
          "maxItems": 128,
"description": "%settings.aiProviders.description%",
          "markdownDescription": "%settings.aiProviders.markdownDescription%",
          "items": {
            "type": "object",
            "required": [
              "provider"
            ],
            "anyOf": [
              { "required": ["nameTokens"], "properties": { "nameTokens": { "minItems": 1 } } },
              { "required": ["emails"], "properties": { "emails": { "minItems": 1 } } },
              { "required": ["bracketTags"], "properties": { "bracketTags": { "minItems": 1 } } },
              { "required": ["messageMarkers"], "properties": { "messageMarkers": { "minItems": 1 } } },
              { "required": ["subjectPrefixes"], "properties": { "subjectPrefixes": { "minItems": 1 } } }
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "title": "%settings.aiProviders.provider.title%",
                "minLength": 1,
                "maxLength": 128,
                "default": "内部编码助手",
                "examples": ["内部编码助手"],
                "markdownDescription": "%settings.aiProviders.provider.description%"
              },
              "nameTokens": {
                "type": "array",
                "title": "%settings.aiProviders.nameTokens.title%",
                "default": [],
                "examples": [["claude"], ["internal assistant"]],
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "markdownDescription": "%settings.aiProviders.nameTokens.description%"
              },
              "emails": {
                "type": "array",
                "title": "%settings.aiProviders.emails.title%",
                "default": [],
                "examples": [["copilot-swe-agent"], ["internal-codebot"]],
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^@<>\\s]+$"
                },
                "markdownDescription": "%settings.aiProviders.emails.description%"
              },
              "bracketTags": {
                "type": "array",
                "title": "%settings.aiProviders.bracketTags.title%",
                "default": [],
                "examples": [["claude"], ["internal-ai"]],
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 31,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{1,30}$"
                },
                "markdownDescription": "%settings.aiProviders.bracketTags.description%"
              },
              "messageMarkers": {
                "type": "array",
                "title": "%settings.aiProviders.messageMarkers.title%",
                "default": [],
                "examples": [["Generated with Claude Code"], ["Generated with Internal Assistant"]],
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "markdownDescription": "%settings.aiProviders.messageMarkers.description%"
              },
              "subjectPrefixes": {
                "type": "array",
                "title": "%settings.aiProviders.subjectPrefixes.title%",
                "default": [],
                "examples": [["aider:"], ["internal-ai:"]],
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
"markdownDescription": "%settings.aiProviders.subjectPrefixes.description%"
              }
            }
          }
        },
        "codeEvolutionLens.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/vendor/**",
            "**/dist/**",
            "**/*.min.*",
            "**/package-lock.json",
            "**/pnpm-lock.yaml",
            "**/yarn.lock",
            "**/Cargo.lock",
            "**/poetry.lock"
          ],
          "examples": [["**/vendor/**", "**/thrift_gen/**"]],
          "markdownDescription": "%settings.excludeGlobs%"
        },
        "codeEvolutionLens.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "examples": [true, false],
          "markdownDescription": "%settings.decorations.enabled%"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run check && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "diff": "8.0.4",
    "minimatch": "11.0.1",
    "sql.js": "1.15.2"
  },
  "overrides": {
    "minimatch": "$minimatch"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.15.30",
    "@types/sql.js": "1.4.9",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.25.5",
    "jsdom": "^26.1.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
